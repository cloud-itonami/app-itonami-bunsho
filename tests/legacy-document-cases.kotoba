;; Synthetic records only, not user data.

(defn lid [b :document] :string (dstr (dget b :legacy-id)))
(defn legacy-positive [] :i64
  (let [raw "{\"found\":true,\"document\":{\"documentId\":\"d-1\",\"title\":\"\\u65e7\\u6587\\u66f8\\ud83d\\ude00\",\"revisionId\":\"rev-7\",\"ownerDid\":\"did:key:owner\",\"createdAtMs\":1700000000000,\"unknown\":{\"keep\":\"yes\"},\"body\":[{\"elementId\":\"e-1\",\"kind\":\"heading\",\"headingLevel\":2,\"text\":\"\\u898b\\u51fa\\u3057\\ud83d\\ude00\",\"startIndex\":0,\"endIndex\":4},{\"elementId\":\"e-2\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u6587\"}]}}" result (legacy-convert raw)]
    (if (not (option-some?-of [:option :document] result)) 0
      (let [state (option-value-of [:option :document] result (document-null))
            edited (set-text state 0 "編集😀") moved (swap edited 0 1)]
        (if (and (string=? (dstr (dget state :legacy-original)) raw)
                 (string=? (dstr (dget state :title)) "旧文書😀")
                 (= (block-count state) 2) (string=? (block-kind state 0) "h2")
                 (string=? (lid (dat (blocks state) 0)) "e-1")
                 (string=? (lid (dat (blocks moved) 0)) "e-2")
                 (string=? (lid (dat (blocks moved) 1)) "e-1")
                 (string=? (block-text moved 1) "編集😀")
                 (string=? (dstr (dget moved :legacy-original)) raw)
                 (not (option-some?-of [:option :string] (snap-encode moved)))) 1 0)))))

(defn legacy-max [] :i64
  (let [result (legacy-convert "{\"found\":true,\"document\":{\"documentId\":\"d\",\"title\":\"T\",\"revisionId\":\"r\",\"body\":[{\"elementId\":\"e0\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u65870\"},{\"elementId\":\"e1\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u65871\"},{\"elementId\":\"e2\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u65872\"},{\"elementId\":\"e3\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u65873\"},{\"elementId\":\"e4\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u65874\"},{\"elementId\":\"e5\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u65875\"},{\"elementId\":\"e6\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u65876\"},{\"elementId\":\"e7\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u65877\"},{\"elementId\":\"e8\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u65878\"},{\"elementId\":\"e9\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u65879\"},{\"elementId\":\"e10\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658710\"},{\"elementId\":\"e11\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658711\"},{\"elementId\":\"e12\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658712\"},{\"elementId\":\"e13\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658713\"},{\"elementId\":\"e14\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658714\"},{\"elementId\":\"e15\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658715\"},{\"elementId\":\"e16\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658716\"},{\"elementId\":\"e17\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658717\"},{\"elementId\":\"e18\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658718\"},{\"elementId\":\"e19\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658719\"},{\"elementId\":\"e20\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658720\"},{\"elementId\":\"e21\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658721\"},{\"elementId\":\"e22\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658722\"},{\"elementId\":\"e23\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658723\"},{\"elementId\":\"e24\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658724\"},{\"elementId\":\"e25\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658725\"},{\"elementId\":\"e26\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658726\"},{\"elementId\":\"e27\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658727\"},{\"elementId\":\"e28\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658728\"},{\"elementId\":\"e29\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658729\"},{\"elementId\":\"e30\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658730\"},{\"elementId\":\"e31\",\"kind\":\"paragraph\",\"text\":\"\\u672c\\u658731\"}]}}")]
    (if (not (option-some?-of [:option :document] result)) 0
      (let [state (option-value-of [:option :document] result (document-null))]
        (if (and (= (block-count state) 32)
                 (string=? (lid (dat (blocks state) 0)) "e0")
                 (string=? (lid (dat (blocks state) 31)) "e31")) 1 0)))))

(defn legacy-list [] :i64
  (let [raw "{\"found\":true,\"document\":{\"documentId\":\"d\",\"title\":\"T\",\"revisionId\":\"r\",\"body\":[{\"elementId\":\"item-1\",\"kind\":\"listItem\",\"text\":\"項目😀\"}]}}"
        result (legacy-convert raw)]
    (if (not (option-some?-of [:option :document] result)) 0
      (let [state (option-value-of [:option :document] result (document-null))]
        (if (and (= (block-count state) 1)
                 (string=? (block-kind state 0) "li")
                 (string=? (block-text state 0) "項目😀")
                 (string=? (lid (dat (blocks state) 0)) "item-1")
                 (string=? (dstr (dget state :legacy-original)) raw)) 1 0)))))

(defn main [] :i64 (+ (legacy-positive) (legacy-list) (legacy-max) (if (option-some?-of [:option :document] (legacy-convert "{\"found\": false}")) 0 1) (if (option-some?-of [:option :document] (legacy-convert "{\"found\":true,\"document\":{\"documentId\":\"d-1\",\"title\":\"\\u65e7\\u6587\\u66f8\\ud83d\\ude00\",\"revisionId\":\"rev-7\",\"ownerDid\":\"did:key:owner\",\"createdAtMs\":1700000000000,\"unknown\":{\"keep\":\"yes\"},\"body\":[{\"elementId\":\"e\",\"kind\":\"heading\",\"headingLevel\":3,\"text\":\"x\"}]}}")) 0 1) (if (option-some?-of [:option :document] (legacy-convert "{\"found\":true,\"document\":{\"documentId\":\"d-1\",\"title\":\"\\u65e7\\u6587\\u66f8\\ud83d\\ude00\",\"revisionId\":\"rev-7\",\"ownerDid\":\"did:key:owner\",\"createdAtMs\":1700000000000,\"unknown\":{\"keep\":\"yes\"},\"body\":[{\"elementId\":\"e\",\"kind\":\"table\",\"text\":\"x\"}]}}")) 0 1) (if (option-some?-of [:option :document] (legacy-convert "{\"found\":true,\"document\":{\"documentId\":\"d-1\",\"title\":\"\\u65e7\\u6587\\u66f8\\ud83d\\ude00\",\"revisionId\":\"rev-7\",\"ownerDid\":\"did:key:owner\",\"createdAtMs\":1700000000000,\"unknown\":{\"keep\":\"yes\"},\"body\":[{\"kind\":\"paragraph\",\"text\":\"x\"}]}}")) 0 1) (if (option-some?-of [:option :document] (legacy-convert "{\"found\":true,\"document\":{\"documentId\":\"d-1\",\"title\":\"\\u65e7\\u6587\\u66f8\\ud83d\\ude00\",\"revisionId\":\"rev-7\",\"ownerDid\":\"did:key:owner\",\"createdAtMs\":1700000000000,\"unknown\":{\"keep\":\"yes\"},\"body\":[{\"elementId\":\"e\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"e\",\"kind\":\"paragraph\",\"text\":\"y\"}]}}")) 0 1) (if (option-some?-of [:option :document] (legacy-convert "{\"found\":true,\"document\":{\"documentId\":\"d-1\",\"title\":\"\\u65e7\\u6587\\u66f8\\ud83d\\ude00\",\"revisionId\":\"rev-7\",\"ownerDid\":\"did:key:owner\",\"createdAtMs\":1700000000000,\"unknown\":{\"keep\":\"yes\"},\"body\":[{\"elementId\":\"e\",\"kind\":\"paragraph\",\"text\":\"\"}]}}")) 0 1) (if (option-some?-of [:option :document] (legacy-convert "{\"found\":true,\"document\":{\"documentId\":\"\",\"title\":\"\\u65e7\\u6587\\u66f8\\ud83d\\ude00\",\"revisionId\":\"rev-7\",\"ownerDid\":\"did:key:owner\",\"createdAtMs\":1700000000000,\"unknown\":{\"keep\":\"yes\"},\"body\":[]}}")) 0 1) (if (option-some?-of [:option :document] (legacy-convert "{\"found\":true,\"document\":{\"documentId\":\"d-1\",\"title\":\"\\u65e7\\u6587\\u66f8\\ud83d\\ude00\",\"revisionId\":null,\"ownerDid\":\"did:key:owner\",\"createdAtMs\":1700000000000,\"unknown\":{\"keep\":\"yes\"},\"body\":[]}}")) 0 1) (if (option-some?-of [:option :document] (legacy-convert "{\"found\":true,\"document\":{\"documentId\":\"d-1\",\"title\":\"\\u65e7\\u6587\\u66f8\\ud83d\\ude00\",\"revisionId\":\"rev-7\",\"ownerDid\":\"did:key:owner\",\"createdAtMs\":1700000000000,\"unknown\":{\"keep\":\"yes\"},\"body\":{}}}")) 0 1) (if (option-some?-of [:option :document] (legacy-convert "{\"found\":true,\"found\":true}")) 0 1) (if (option-some?-of [:option :document] (legacy-convert "{\"found\":true,\"document\":{\"documentId\":\"d-1\",\"title\":\"\\u65e7\\u6587\\u66f8\\ud83d\\ude00\",\"revisionId\":\"rev-7\",\"ownerDid\":\"did:key:owner\",\"createdAtMs\":1700000000000,\"unknown\":{\"keep\":\"yes\"},\"body\":[{\"elementId\":\"0\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"1\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"2\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"3\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"4\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"5\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"6\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"7\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"8\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"9\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"10\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"11\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"12\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"13\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"14\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"15\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"16\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"17\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"18\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"19\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"20\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"21\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"22\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"23\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"24\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"25\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"26\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"27\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"28\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"29\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"30\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"31\",\"kind\":\"paragraph\",\"text\":\"x\"},{\"elementId\":\"32\",\"kind\":\"paragraph\",\"text\":\"x\"}]}}")) 0 1)))
