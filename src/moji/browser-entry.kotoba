;; App-owned browser program entry. The build stages this alongside the editor
;; definitions and exports this `main`; browser state remains local to the host.
;; argv: init | step SNAPSHOT TARGET KIND VALUE. A successful run writes one
;; versioned snapshot. Refusals write no snapshot and keep the host's prior one.
(defn browser-arg [i :string] :string
  (typed-cap-call :cli/args :string :string i))

;; BS3 protects multiline editable fields from older single-line browsers.
;; The discriminator retains either the exact BS1 or legacy-provenance BS2
;; payload. State data and original JSON remain unchanged.
(defn browser-has-break? [s :string] :bool
  (or (>= (string-index-of s "\n") 0) (>= (string-index-of s "\r") 0)))
(defn browser-block-has-break? [v :document i :i64] :bool
  (if (>= i (document-count v)) false
    (or (browser-has-break? (dstr (dget (dat v i) :text)))
        (browser-block-has-break? v (+ i 1)))))
(defn browser-encode [s :document] [:option :string]
  (let [legacy (and (map? s) (= (document-count s) 4))
        encoded (if legacy (legacy-snapshot-encode s) (snap-encode s))]
    (if (not (option-some?-of [:option :string] encoded)) (option-none-of [:option :string])
      (let [raw (option-value-of [:option :string] encoded "")
            multiline (or (browser-has-break? (dstr (dget s :title)))
                          (browser-block-has-break? (dget s :blocks) 0))
            result (if multiline
                     (string-concat (if legacy "BS3|2" "BS3|1") (string-substring raw 4 (string-byte-length raw))) raw)]
        (if (> (string-byte-length result) 35000) (option-none-of [:option :string])
          (option-some-of [:option :string] result))))))

;; Check ASCII prefix byte-by-byte so malformed UTF-8-aligned text never
;; creates a substring ending inside a multibyte character.
(defn browser-prefix? [s :string v :i64] :bool
  (and (>= (string-byte-length s) 4) (= (string-code-point-at s 0) 66)
       (= (string-code-point-at s 1) 83) (= (string-code-point-at s 2) v)
       (= (string-code-point-at s 3) 124)))
(defn browser-decode [s :string] [:option :document]
  (cond (browser-prefix? s 49) (snap-decode s)
        (browser-prefix? s 50) (legacy-snapshot-decode s)
        (and (browser-prefix? s 51) (>= (string-byte-length s) 5))
          (let [version (string-code-point-at s 4)]
            (cond (= version 49) (snap-decode (string-concat "BS1|" (string-substring s 5 (string-byte-length s))))
                  (= version 50) (legacy-snapshot-decode (string-concat "BS2|" (string-substring s 5 (string-byte-length s))))
                  :else (option-none-of [:option :document])))
        :else (option-none-of [:option :document])))
(defn browser-emit [s :document] :i64
  (let [encoded (browser-encode s)]
    (if (option-some?-of [:option :string] encoded)
      (let [out (typed-cap-call :io/write :string :string
                  (string-concat (option-value-of [:option :string] encoded "") "\n"))] 0)
      2)))

;; Encode the editor's declarative view, not browser objects. Every node is
;; tag, class, type, data-k, value, text, accessible label and child count, followed by children.
;; The host only validates this bounded wire value and renders its nodes.
(defn browser-view-children [v :document i :i64 n :i64] :i64
  (if (= i n) 0
    (let [rendered (browser-view-node (dat v i))]
      (if (= rendered 0) (browser-view-children v (+ i 1) n) rendered))))

(defn browser-view-head [node :document n :i64] :i64
  (let [attrs (dget node :attrs)
        emitted (arena-scope
                  (let [fields (string-concat (snap-frame (dstr (dget node :tag)))
                                 (string-concat (snap-frame (dstr (dget attrs :class)))
                                  (string-concat (snap-frame (dstr (dget attrs :type)))
                                   (string-concat (snap-frame (dstr (dget attrs :data-k)))
                                    (string-concat (snap-frame (dstr (dget attrs :value)))
                                     (string-concat (snap-frame (dstr (dget node :text)))
                                      (string-concat (snap-frame (dstr (dget attrs :aria-label)))
                                                     (snap-frame (string-from-i64 n)))))))))
                        out (typed-cap-call :io/write :string :string fields)] 0))]
    emitted))

(defn browser-view-node [node :document] :i64
  (let [children (dget node :children)
        n (if (vector? children) (document-count children) 0)
        emitted (browser-view-head node n)]
    (if (= emitted 0) (browser-view-children children 0 n) emitted)))

;; Validate the entire BS1 payload before emitting any view bytes. Each scan
;; retains only an offset; the document's text and view rows need not coexist
;; in the runtime arena. BS2 provenance continues through its own validator.
(defn browser-scan-block [raw :string at :i64] :i64
  (arena-scope
    (let [k (snap-read raw at)]
      (if (< (vector-at k 0) 0) -1
        (let [t (snap-read raw (vector-at k 2))]
          (if (or (< (vector-at t 0) 0) (not (snap-kind? (snap-text raw k))))
            -1 (vector-at t 2)))))))

(defn browser-scan-blocks [raw :string at :i64 left :i64] :bool
  (if (= left 0) (= at (string-byte-length raw))
    (let [next (browser-scan-block raw at)]
      (and (>= next 0) (browser-scan-blocks raw next (- left 1))))))

;; Encode the next offset and UTF-8 text length in a scalar before the arena
;; is released. Frame lengths are bounded to 1024 bytes by snap-read.
(defn browser-render-row [raw :string at :i64 i :i64 start :i64 preview :bool] :i64
  (arena-scope
    (let [k (snap-read raw at) t (snap-read raw (vector-at k 2))
          kind (snap-text raw k) text (snap-text raw t)
          node (if preview (preview-node-fields kind text)
                 (edit-row-fields kind i start text))
          emitted (browser-view-node node)]
      (+ (* (vector-at t 2) 2048) (string-byte-length text)))))

(defn browser-render-rows [raw :string at :i64 i :i64 n :i64 start :i64 preview :bool] :i64
  (if (= i n) (if (= n 0) 1 (- start 1))
    (let [row (browser-render-row raw at i start preview)]
      (browser-render-rows raw (quot row 2048) (+ i 1) n
                           (next-start start (rem row 2048)) preview))))

(defn browser-render-bs1 [raw :string offset :i64] :i64
  (let [title (snap-read raw offset)]
    (if (< (vector-at title 0) 0) 3
      (let [mode-frame (snap-read raw (vector-at title 2))]
        (if (< (vector-at mode-frame 0) 0) 3
          (let [count-frame (snap-read raw (vector-at mode-frame 2))
                mode (snap-text raw mode-frame)]
            (if (or (< (vector-at count-frame 0) 0)
                    (not (or (string=? mode "edit") (string=? mode "preview")))) 3
              (let [n (snap-number (snap-text raw count-frame) 0)
                    start (vector-at count-frame 2)]
                (if (or (< n 0) (not (browser-scan-blocks raw start n))) 3
                  (let [preview (string=? mode "preview")
                        shell (view (document-map :title (document-string (snap-text raw title))
                                                  :mode (document-string mode)
                                                  :blocks (document-vector)))
                        children (dget shell :children)
                        prefix (typed-cap-call :io/write :string :string "BV2|")
                        root (browser-view-head shell 4)
                        header (browser-view-node (dat children 0))
                        tools (browser-view-node (dat children 1))
                        main (browser-view-head (dat children 2) n)
                        end (browser-render-rows raw start 0 n 1 preview)
                        footer (document-assoc (dat children 3) :text
                                 (document-string (string-concat (string-from-i64 n)
                                   (string-concat " ブロック · 本文 index 1–" (string-from-i64 end)))))
                        rendered (browser-view-node footer)
                        out (typed-cap-call :io/write :string :string "\n")] 0))))))))))

(defn browser-render [raw :string] :i64
  (if (> (string-byte-length raw) 35000) 3
    (if (browser-prefix? raw 49) (browser-render-bs1 raw 4)
     (if (and (browser-prefix? raw 51) (>= (string-byte-length raw) 5)
              (= (string-code-point-at raw 4) 49)) (browser-render-bs1 raw 5)
    (let [decoded (browser-decode raw)]
      (if (option-some?-of [:option :document] decoded)
        (let [state (option-value-of [:option :document] decoded (init))
              prefix (typed-cap-call :io/write :string :string "BV2|")
              result (browser-view-node (view state))
              out (typed-cap-call :io/write :string :string "\n")] result)
        3))))))

(defn main [] :i64
  (let [argc (browser-arg "") op (browser-arg "0")]
    (cond
      (and (string=? argc "1") (string=? op "init")) (browser-emit (init))
      (and (string=? argc "2") (string=? op "view")) (browser-render (browser-arg "1"))
      (and (string=? argc "2") (string=? op "protect"))
        (let [raw (browser-arg "1")]
          (if (> (string-byte-length raw) 35000) 3
            (let [decoded (browser-decode raw)]
              (if (option-some?-of [:option :document] decoded)
                (browser-emit (option-value-of [:option :document] decoded (document-null))) 3))))
      (and (string=? argc "2") (string=? op "legacy-import"))
        (let [raw (browser-arg "1")]
          (if (> (string-byte-length raw) 35000) 3
            (let [converted (legacy-convert raw)]
              (if (option-some?-of [:option :document] converted)
                (browser-emit (option-value-of [:option :document] converted (document-null))) 3))))
      (and (string=? argc "2") (string=? op "legacy-original"))
        (let [raw (browser-arg "1") decoded (if (> (string-byte-length raw) 35000)
                        (option-none-of [:option :document]) (browser-decode raw))
              original (if (option-some?-of [:option :document] decoded)
                         (document-get (option-value-of [:option :document] decoded (document-null)) :legacy-original)
                         (option-none-of [:option :document]))]
          (if (and (option-some?-of [:option :document] original)
                   (string? (option-value-of [:option :document] original (document-null))))
            (let [out (typed-cap-call :io/write :string :string
                        (string-concat (dstr (option-value-of [:option :document] original (document-null))) "\n"))] 0)
            3))
      (and (string=? argc "5") (string=? op "step"))
        (let [raw (browser-arg "1") target (browser-arg "2")
              kind (browser-arg "3") value (browser-arg "4")]
          (if (or (> (string-byte-length raw) 35000) (> (string-byte-length target) 128)
                  (> (string-byte-length value) 1024)
                  (not (or (string=? kind "click") (string=? kind "input"))))
            3
            (let [decoded (browser-decode raw)]
              (if (option-some?-of [:option :document] decoded)
                (browser-emit (step (option-value-of [:option :document] decoded (init)) target kind value))
                3))))
      :else 4)))
